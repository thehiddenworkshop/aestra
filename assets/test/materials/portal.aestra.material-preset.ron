(
    schema_version: 2,
    id: "a3574a00-0000-4000-8000-00000000a107",
    display_name: "Portal",
    description: "Forms an animated elliptical portal ring with a violet-to-gold energy gradient.",
    category: Motion,
    tags: ["portal", "ring", "vortex", "animated", "magic"],
    recipe: Graph((
        nodes: [
            (name: "uv", kind: Input(Uv0)),
            (name: "center", kind: Constant(Vec2((0.5, 0.5)))),
            (name: "time", kind: Input(EffectTime)),
            (name: "rotated_uv", kind: Function(RotateUv), inputs: {"Uv": Node("uv"), "Center": Node("center"), "Angle": Node("time")}),
            (name: "ellipse_scale", kind: Constant(Vec2((1.0, 1.35)))),
            (name: "ellipse_uv", kind: Function(ScaleUv), inputs: {"Uv": Node("rotated_uv"), "Center": Node("center"), "Scale": Node("ellipse_scale")}),
            (name: "outer_radius", kind: Constant(Float(0.49))),
            (name: "outer_softness", kind: Constant(Float(0.08))),
            (name: "invert", kind: Constant(Bool(false))),
            (name: "outer", kind: Function(RadialMask), inputs: {"Uv": Node("ellipse_uv"), "Center": Node("center"), "Radius": Node("outer_radius"), "Softness": Node("outer_softness"), "Invert": Node("invert")}),
            (name: "inner_radius", kind: Constant(Float(0.31))),
            (name: "inner_softness", kind: Constant(Float(0.06))),
            (name: "inner", kind: Function(RadialMask), inputs: {"Uv": Node("ellipse_uv"), "Center": Node("center"), "Radius": Node("inner_radius"), "Softness": Node("inner_softness"), "Invert": Node("invert")}),
            (name: "ring", kind: Function(Subtract), inputs: {"A": Node("outer"), "B": Node("inner")}),
            (name: "opacity", kind: Function(Multiply), inputs: {"A": Source, "B": Node("ring")}),
            (name: "violet", kind: Constant(ColorSrgb((0.46, 0.12, 1.0, 1.0)))),
            (name: "gold", kind: Constant(ColorSrgb((1.0, 0.48, 0.08, 1.0)))),
            (name: "phase", kind: Input(ParticleNormalizedAge)),
            (name: "portal_tint", kind: Function(Lerp), inputs: {"Start": Node("violet"), "End": Node("gold"), "Factor": Node("phase")}),
            (name: "color", kind: Function(Multiply), inputs: {"A": ProgramColor, "B": Node("portal_tint")}),
        ],
        output: Node("opacity"),
        program_outputs: {Color: Node("color"), Alpha: Node("opacity")},
    )),
)
