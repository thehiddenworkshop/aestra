(
    schema_version: 2,
    id: "a3574a00-0000-4000-8000-00000000a105",
    display_name: "Magic Shield",
    description: "Combines a rounded coverage mask with a luminous view-dependent violet shield edge.",
    category: Shaping,
    tags: ["magic", "shield", "fresnel", "barrier", "glow"],
    recipe: Graph((
        nodes: [
            (name: "normal", kind: Input(Normal)),
            (name: "view", kind: Input(ViewDirection)),
            (name: "power", kind: Constant(Float(2.2))),
            (name: "fresnel", kind: Function(Fresnel), inputs: {"Normal": Node("normal"), "ViewDirection": Node("view"), "Power": Node("power")}),
            (name: "uv", kind: Input(Uv0)),
            (name: "center", kind: Constant(Vec2((0.5, 0.5)))),
            (name: "radius", kind: Constant(Float(0.49))),
            (name: "softness", kind: Constant(Float(0.08))),
            (name: "invert", kind: Constant(Bool(false))),
            (name: "coverage", kind: Function(RadialMask), inputs: {"Uv": Node("uv"), "Center": Node("center"), "Radius": Node("radius"), "Softness": Node("softness"), "Invert": Node("invert")}),
            (name: "edge", kind: Function(Multiply), inputs: {"A": Node("coverage"), "B": Node("fresnel")}),
            (name: "base", kind: Constant(Float(0.18))),
            (name: "lit_edge", kind: Function(Add), inputs: {"A": Node("base"), "B": Node("edge")}),
            (name: "opacity", kind: Function(Multiply), inputs: {"A": Source, "B": Node("lit_edge")}),
            (name: "shield_tint", kind: Constant(ColorSrgb((0.34, 0.2, 1.0, 1.0)))),
            (name: "color", kind: Function(Multiply), inputs: {"A": ProgramColor, "B": Node("shield_tint")}),
        ],
        output: Node("opacity"),
        program_outputs: {Color: Node("color"), Alpha: Node("opacity")},
    )),
)
