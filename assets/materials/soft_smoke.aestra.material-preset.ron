(
    schema_version: 2,
    id: "a3574a00-0000-4000-8000-00000000a103",
    display_name: "Soft Smoke",
    description: "Shapes translucent smoke with gentle birth and death fades and a restrained density.",
    category: Masking,
    tags: ["smoke", "soft", "fade", "opacity", "particle age"],
    recipe: Graph((
        nodes: [
            (name: "age", kind: Input(ParticleNormalizedAge)),
            (name: "zero", kind: Constant(Float(0.0))),
            (name: "birth_end", kind: Constant(Float(0.18))),
            (name: "fade_in", kind: Function(Smoothstep), inputs: {"LowerEdge": Node("zero"), "UpperEdge": Node("birth_end"), "Value": Node("age")}),
            (name: "one", kind: Constant(Float(1.0))),
            (name: "remaining_life", kind: Function(Subtract), inputs: {"A": Node("one"), "B": Node("age")}),
            (name: "death_end", kind: Constant(Float(0.42))),
            (name: "fade_out", kind: Function(Smoothstep), inputs: {"LowerEdge": Node("zero"), "UpperEdge": Node("death_end"), "Value": Node("remaining_life")}),
            (name: "envelope", kind: Function(Multiply), inputs: {"A": Node("fade_in"), "B": Node("fade_out")}),
            (name: "soft_alpha", kind: Function(Multiply), inputs: {"A": Source, "B": Node("envelope")}),
            (name: "density", kind: Constant(Float(0.78))),
            (name: "opacity", kind: Function(Multiply), inputs: {"A": Node("soft_alpha"), "B": Node("density")}),
            (name: "smoke_tint", kind: Constant(ColorSrgb((0.48, 0.54, 0.62, 1.0)))),
            (name: "color", kind: Function(Multiply), inputs: {"A": ProgramColor, "B": Node("smoke_tint")}),
        ],
        output: Node("opacity"),
        program_outputs: {Color: Node("color"), Alpha: Node("opacity")},
    )),
)
