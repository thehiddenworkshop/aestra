(
    id: "a3574a00-0000-4000-8000-00000000a201",
    schema_version: 1,
    name: "Mesh Material Lab",
    domain: Mesh,
    render_state_policy: (
        default: (blend: Alpha, depth_test: LessEqual, depth_write: false, cull_mode: Back),
