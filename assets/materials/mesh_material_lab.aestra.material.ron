        (id: "a3574a00-0000-4000-8000-00000000a224", kind: Add("a3574a00-0000-4000-8000-00000000a223", "a3574a00-0000-4000-8000-00000000a222")),
        (id: "a3574a00-0000-4000-8000-00000000a227", kind: Input(ParticleOpacity)),
        // Radial breathing: local position * (2.4 * age * (1 - age)).
        (id: "a3574a00-0000-4000-8000-00000000a230", kind: Input(LocalPosition)),
        (id: "a3574a00-0000-4000-8000-00000000a231", kind: Input(ParticleNormalizedAge)),
        (id: "a3574a00-0000-4000-8000-00000000a232", kind: Constant(Float(1.0))),
        (id: "a3574a00-0000-4000-8000-00000000a233", kind: Subtract("a3574a00-0000-4000-8000-00000000a232", "a3574a00-0000-4000-8000-00000000a231")),
        (id: "a3574a00-0000-4000-8000-00000000a234", kind: Multiply("a3574a00-0000-4000-8000-00000000a231", "a3574a00-0000-4000-8000-00000000a233")),
        (id: "a3574a00-0000-4000-8000-00000000a235", kind: Parameter("a3574a00-0000-4000-8000-00000000a211")),
        (id: "a3574a00-0000-4000-8000-00000000a236", kind: Multiply("a3574a00-0000-4000-8000-00000000a234", "a3574a00-0000-4000-8000-00000000a235")),
        (id: "a3574a00-0000-4000-8000-00000000a237", kind: Multiply("a3574a00-0000-4000-8000-00000000a230", "a3574a00-0000-4000-8000-00000000a236")),
    ],
    inline_constants: ["a3574a00-0000-4000-8000-00000000a222", "a3574a00-0000-4000-8000-00000000a232"],
    outputs: (color: "a3574a00-0000-4000-8000-00000000a224", alpha: "a3574a00-0000-4000-8000-00000000a227", vertex_offset: Some("a3574a00-0000-4000-8000-00000000a237")),
