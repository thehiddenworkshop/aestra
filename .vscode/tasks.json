{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aestra: Run Editor",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "-p", "aestra-editor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Aestra: Visual Regression",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "aestra-viewer",
        "--",
        "--visual-test",
        "aestra-viewer/tests/references/prism_bloom",
        "target/visual-regression/prism-bloom",
        "--frames",
        "8"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
