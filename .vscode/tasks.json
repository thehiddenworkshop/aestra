{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aestra: Run Editor",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "-p", "aestra-editor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
