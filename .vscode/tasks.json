{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aestra: Run Editor",
      "type": "shell",
      "command": "cargo",
      "args": ["editor-dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Aestra: Run Fireworks Demo",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--locked",
        "-p",
        "aestra-demo-fireworks",
        "--",
        "--launch-pattern",
        "variety",
        "--scene",
        "sea",
        "--tier",
        "medium",
        "--tuned-smoke",
        "--star-lights",
        "--experimental-oit",
        "--oit-partitions",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Aestra: Review Gold Filament Study",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--release", "--locked", "-p", "aestra-demo-fireworks", "--", "--smoke-art-show", "--effect", "effects/fireworks_gold_filament_candidate.aestra.ron", "--tier", "high", "--experimental-oit", "--star-lights", "--no-audio"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$rustc"],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Aestra: Run Benchmarks",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "aestra-bench",
        "--",
        "--all",
        "--out",
        "target/bench/latest.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
